{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "env": {
          "GRADLE_OPTS": "-Xmx4g -XX:+UseG1GC",
          "ORG_GRADLE_PROJECT_android_useAndroidX": "true",
          "ORG_GRADLE_PROJECT_android_enableJetifier": "true"
        }
      }
    },
    "preview2": {
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview3": {
      "developmentClient": true
    },
    "production": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "env": {
          "GRADLE_OPTS": "-Xmx4g -XX:+UseG1GC",
          "ORG_GRADLE_PROJECT_android_useAndroidX": "true",
          "ORG_GRADLE_PROJECT_android_enableJetifier": "true",
          "ORG_GRADLE_PROJECT_react_native_gradle_plugin_version": "0.75.0"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}

